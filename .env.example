# Backend Environment Variables (Server)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster0
DB_NAME=cadence
PORT=3001
JWT_SECRET=your_jwt_secret_key_here

# Frontend Environment Variables (Vite)
# Leave blank for local development using Vite proxy (/api -> http://localhost:3001)
# Set to your deployed backend URL (e.g. https://your-backend.onrender.com/api) when deploying frontend to GitHub Pages / Vercel / Netlify
VITE_API_URL=
